// QMI data-session helper for the external SDX55: started by init as the IMS
// DCM server (vendor.kebab_ims_dcm) and used for manual QMI/DIAG probing.
cc_binary {
    name: "kebab-dataconn",
    vendor: true,
    srcs: ["kebab-dataconn.c"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
}
