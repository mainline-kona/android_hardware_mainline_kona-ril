// QMI data-session helper for the external SDX55; spawned by libcuttlefish-ril-2
cc_binary {
    name: "kebab-dataconn",
    vendor: true,
    srcs: ["kebab-dataconn.c"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
}
