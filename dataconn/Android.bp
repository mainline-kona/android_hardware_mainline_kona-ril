cc_binary {
    name: "kona-dataconn",
    vendor: true,
    srcs: ["dataconn.c"],
    cflags: [
        "-DHAVE_CONFIG_H",
        "-Wno-deprecated-declarations",
        "-Wno-unused-parameter",
    ],
    header_libs: [
        "libqmi_config_header",
        "libqmi_top_headers",
        "libqmi_libqmi_glib_headers",
    ],
    shared_libs: [
        "libgio-2.0",
        "libglib-2.0",
        "libgobject-2.0",
        "libqmi-glib",
        "libqrtr-glib",
    ],
}
