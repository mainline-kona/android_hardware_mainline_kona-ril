# The SDX55 exposes a single AT port (MHI DUN, channels 32/33) as wwan0at0
service vendor.ril-daemon /vendor/bin/hw/libcuttlefish-rild -l libcuttlefish-ril-2.so -- -d /dev/wwan0at0
    class main
    user radio
    group radio inet misc audio log readproc wakelock
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
