# The first AT port rejects most configuration commands, the second takes them
service vendor.ril-daemon /vendor/bin/hw/libcuttlefish-rild -l libcuttlefish-ril-2.so -- -d /dev/wwan0at1
    class main
    user radio
    group radio inet misc audio log readproc wakelock
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
